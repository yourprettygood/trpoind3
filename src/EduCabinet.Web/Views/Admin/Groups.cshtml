@model List<EduCabinet.Web.Models.Entities.StudentGroup>
@{
    ViewData["Title"] = "Учебные группы";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-collection text-dark me-2"></i>Учебные группы студентов</h2>
        <p class="text-muted mb-0">Справочник учебных групп для формирования ведомостей и контроля успеваемости.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Добавить группу</h5>
            </div>
            <div class="card-body p-3">
                <form asp-action="CreateGroup" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Название группы</label>
                        <input name="Name" class="form-control" placeholder="Например: ИС-31" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Номер курса</label>
                        <input name="CourseNumber" class="form-control" type="number" min="1" max="6" value="3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Описание / Специальность</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Например: Информационные системы и программирование"></textarea>
                    </div>
                    <button type="submit" class="btn btn-dark w-100">
                        <i class="bi bi-check2 me-1"></i>Создать группу
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark">Список действующих групп</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Группа</th>
                                <th class="text-center">Курс</th>
                                <th>Описание</th>
                                <th class="text-center">Студентов</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@g.Name</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@g.CourseNumber курс</span></td>
                                    <td><small class="text-muted">@g.Description</small></td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@g.Memberships.Count чел.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
