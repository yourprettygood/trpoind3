@model EduCabinet.Web.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Панель администратора";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-dark me-2"></i>Администрирование системы</h2>
        <p class="text-muted mb-0">Мониторинг пользователей, аудит безопасности, разграничение прав доступа (RBAC).</p>
    </div>
</div>

<!-- Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-dark bg-opacity-10 text-dark p-3 rounded-3 me-3 fs-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small">Всего пользователей</h6>
                    <h3 class="fw-bold mb-0">@Model.TotalUsers</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3 fs-3">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small">Преподавателей</h6>
                    <h3 class="fw-bold mb-0">@Model.TeachersCount</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 me-3 fs-3">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small">Студентов</h6>
                    <h3 class="fw-bold mb-0">@Model.StudentsCount</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-3 me-3 fs-3">
                    <i class="bi bi-ui-checks"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small">Попыток тестирования</h6>
                    <h3 class="fw-bold mb-0">@Model.TotalAttemptsCount</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Security Audit Logs -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2"></i>Последние события аудита безопасности</h5>
        <a asp-action="AuditLogs" class="btn btn-outline-secondary btn-sm">Все события</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentAuditLogs.Any())
        {
            <div class="p-3 text-muted text-center small">
                Записей в журнале аудита пока нет.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-start">
                    <thead class="table-light">
                        <tr>
                            <th>Дата и время</th>
                            <th>Действие</th>
                            <th>Инициатор</th>
                            <th>Подробности</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <tr>
                                <td class="text-muted small">@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td><span class="badge bg-secondary">@log.Action</span></td>
                                <td><strong>@log.UserName</strong></td>
                                <td class="small">@log.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
