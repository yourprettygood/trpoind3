@model List<EduCabinet.Web.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "Пользователи и роли";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-dark me-2"></i>Реестр пользователей системы</h2>
        <p class="text-muted mb-0">Управление учетными записями, ролями (RBAC) и привязкой к группам.</p>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ФИО</th>
                        <th>Email / Логин</th>
                        <th>Роль в системе</th>
                        <th>Учебная группа</th>
                        <th>Дата регистрации</th>
                        <th class="text-end pe-3">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-bold">@u.FullName</td>
                            <td>@u.Email</td>
                            <td>
                                @if (u.Role == "Administrator")
                                {
                                    <span class="badge bg-dark">Администратор</span>
                                }
                                else if (u.Role == "Teacher")
                                {
                                    <span class="badge bg-primary">Преподаватель</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Студент</span>
                                }
                            </td>
                            <td>@(u.GroupName ?? "—")</td>
                            <td class="text-muted small">@u.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="text-end pe-3">
                                <a asp-action="EditUser" asp-route-id="@u.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil me-1"></i>Изменить роль
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
