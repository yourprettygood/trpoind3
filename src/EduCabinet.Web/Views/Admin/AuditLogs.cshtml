@model List<EduCabinet.Web.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Журнал аудита безопасности";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-dark me-2"></i>Журнал аудита действий</h2>
        <p class="text-muted mb-0">Фиксация критических действий: ручные разблокировки лекций, изменение ролей и конфигурации.</p>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">
                Записей аудита не обнаружено.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 15%;">Дата и время</th>
                            <th style="width: 15%;">Событие</th>
                            <th style="width: 20%;">Пользователь</th>
                            <th style="width: 50%;">Подробное описание</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-muted small">@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>
                                    @if (log.Action == "ManualLectureUnlock")
                                    {
                                        <span class="badge bg-warning text-dark">Ручной допуск</span>
                                    }
                                    else if (log.Action == "UserUpdated")
                                    {
                                        <span class="badge bg-info text-dark">Смена роли</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@log.Action</span>
                                    }
                                </td>
                                <td><strong>@log.UserName</strong></td>
                                <td class="small">@log.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
