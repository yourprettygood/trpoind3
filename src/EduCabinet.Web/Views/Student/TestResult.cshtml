@model EduCabinet.Web.Models.Entities.TestAttempt
@{
    ViewData["Title"] = "Результаты тестирования";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header @(Model.IsPassed ? "bg-success" : "bg-danger") text-white py-3 text-center">
                <h3 class="mb-0 fw-bold">
                    <i class="bi @(Model.IsPassed ? "bi-check-circle-fill" : "bi-x-circle-fill") me-2"></i>
                    @(Model.IsPassed ? "Тест успешно пройден!" : "Тест не пройден")
                </h3>
            </div>

            <div class="card-body p-4 text-center">
                <div class="display-3 fw-bold @(Model.IsPassed ? "text-success" : "text-danger") mb-2">
                    @Model.ScorePercent%
                </div>
                <p class="fs-5 text-muted mb-4">
                    Набрано баллов: <strong>@Model.TotalPoints</strong> из <strong>@Model.MaxPoints</strong> возможных.
                    Проходной порог теста: <strong>@Model.Test.PassingScorePercent%</strong>.
                </p>

                @if (Model.IsPassed)
                {
                    <div class="alert alert-success d-inline-block text-start px-4 py-3 mb-4">
                        <i class="bi bi-unlock-fill me-2 fs-5"></i>
                        <strong>Поздравляем!</strong> Вы успешно подтвердили усвоение материала. Следующая лекция курса теперь разблокирована для изучения!
                    </div>
                }
                else
                {
                    <div class="alert alert-danger d-inline-block text-start px-4 py-3 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        Результат ниже требуемого проходного балла (@Model.Test.PassingScorePercent%).
                        Повторите теоретический материал и воспользуйтесь оставшимися попытками.
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Lecture" asp-route-id="@Model.Test.LectureId" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-arrow-left me-1"></i>К лекции
                    </a>
                    <a asp-action="Discipline" asp-route-id="@Model.Test.Lecture.Topic.DisciplineId" class="btn btn-outline-secondary px-4 py-2">
                        <i class="bi bi-list-check me-1"></i>К программе курса
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
