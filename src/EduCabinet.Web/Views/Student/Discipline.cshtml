@model EduCabinet.Web.ViewModels.StudentDisciplineDetailsViewModel
@{
    ViewData["Title"] = Model.Discipline.Title;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Дисциплины</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Discipline.Title</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 rounded-3 mb-4 bg-white">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-primary bg-opacity-10 text-primary mb-2">Учебный курс</span>
                <h3 class="fw-bold mb-2">@Model.Discipline.Title</h3>
                <p class="text-muted mb-3">@Model.Discipline.Description</p>
                <div class="d-flex align-items-center text-muted small">
                    <span class="me-4"><i class="bi bi-person-circle me-1"></i>Преподаватель: <strong>@(Model.Discipline.Teacher?.FullName ?? "Иванов С.П.")</strong></span>
                    <span><i class="bi bi-calendar3 me-1"></i>Создан: @Model.Discipline.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="p-3 bg-light rounded text-center">
                    <span class="text-muted small d-block mb-1">Освоение курса</span>
                    <h2 class="fw-bold text-primary mb-2">@Model.OverallProgressPercent%</h2>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.OverallProgressPercent%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<h4 class="fw-bold mb-3"><i class="bi bi-list-check text-primary me-2"></i>Темы и учебные материалы курса</h4>

<div class="accordion" id="curriculumAccordion">
    @for (int i = 0; i < Model.Topics.Count; i++)
    {
        var topicVm = Model.Topics[i];

        <div class="card border-0 shadow-sm rounded-3 mb-3 overflow-hidden">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center" id="heading_@topicVm.Topic.Id">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-folder-fill text-warning me-2"></i>@topicVm.Topic.Title
                    </h5>
                    @if (!string.IsNullOrEmpty(topicVm.Topic.Description))
                    {
                        <small class="text-muted">@topicVm.Topic.Description</small>
                    }
                </div>
                <span class="badge bg-light text-dark border">@topicVm.Lectures.Count лекций</span>
            </div>

            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var item in topicVm.Lectures)
                    {
                        var lec = item.Lecture;
                        <li class="list-group-item p-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-start me-3">
                                <div class="me-3 mt-1 fs-4">
                                    @if (item.FinalGrade.HasValue)
                                    {
                                        string iconColor = item.FinalGrade.Value >= 4 ? "text-success" : (item.FinalGrade.Value == 3 ? "text-warning" : "text-danger");
                                        <i class="bi bi-check-circle-fill @iconColor"></i>
                                    }
                                    else if (item.IsOverdue)
                                    {
                                        <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-book text-primary"></i>
                                    }
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">
                                        @lec.Title
                                    </h6>
                                    @if (!string.IsNullOrEmpty(lec.Description))
                                    {
                                        <p class="small text-muted mb-1">@lec.Description</p>
                                    }

                                    <div class="d-flex flex-wrap gap-2 align-items-center mt-1">
                                        <!-- Оценка -->
                                        @if (item.FinalGrade.HasValue)
                                        {
                                            string badgeClass = item.FinalGrade.Value switch
                                            {
                                                5 => "bg-success",
                                                4 => "bg-primary",
                                                3 => "bg-warning text-dark",
                                                _ => "bg-danger"
                                            };
                                            <span class="badge @badgeClass fs-6 px-2 py-1">
                                                Оценка: @item.FinalGrade.Value
                                            </span>
                                        }
                                        else if (item.IsOverdue)
                                        {
                                            <span class="badge bg-danger fs-6 px-2 py-1">
                                                Оценка: 2 (Просрочено)
                                            </span>
                                        }

                                        <!-- Дедлайн -->
                                        @if (lec.Deadline.HasValue)
                                        {
                                            bool isPassedDeadline = DateTime.UtcNow > lec.Deadline.Value;
                                            <span class="badge @(isPassedDeadline ? "bg-danger-subtle text-danger border" : "bg-info-subtle text-dark border")">
                                                <i class="bi bi-calendar-event me-1"></i>Срок: до @lec.Deadline.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </span>
                                        }

                                        <!-- Тест -->
                                        @if (item.BestTestScore.HasValue)
                                        {
                                            <span class="badge @(item.IsTestPassed ? "bg-success-subtle text-success border" : "bg-danger-subtle text-danger border")">
                                                Тест: @item.BestTestScore%
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div>
                                <a asp-action="Lecture" asp-route-id="@lec.Id" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                                    Изучить <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>
