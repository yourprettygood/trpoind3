@model EduCabinet.Web.ViewModels.GradeSubmissionViewModel
@{
    ViewData["Title"] = "Проверка ответа студента";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="ReviewAnswers">Проверка ответов</a></li>
        <li class="breadcrumb-item active">Оценивание ответа</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Проверка контрольного задания</h4>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4 pb-3 border-bottom">
                    <div class="col-md-6">
                        <span class="text-muted small">Обучающийся:</span>
                        <h5 class="fw-bold mb-0">@Model.StudentName</h5>
                    </div>
                    <div class="col-md-6 text-md-end mt-2 mt-md-0">
                        <span class="text-muted small">Курс:</span>
                        <div class="fw-semibold">@Model.DisciplineTitle</div>
                        <small class="text-muted">@Model.LectureTitle</small>
                    </div>
                </div>

                <!-- Вопрос -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary">Текст контрольного вопроса:</label>
                    <div class="p-3 bg-light rounded-2 border">
                        @Model.QuestionText
                    </div>
                </div>

                <!-- Ответ студента (Строго по GEMINI.md Rule 1: неизменяемый текст заявителя) -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label fw-bold text-dark mb-0">
                            <i class="bi bi-person-fill me-1"></i>Ответ студента (исходный текст):
                        </label>
                        <span class="text-muted small">
                            Отправлено: @Model.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </div>
                    <div class="p-3 bg-white border border-2 rounded-2" style="white-space: pre-wrap;">@Model.StudentAnswerText</div>
                </div>

                <!-- Резолюция преподавателя (изолированные поля) -->
                <form asp-action="GradeAnswer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AnswerId" />

                    <div class="card bg-light border p-3 rounded-3 mb-4">
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-award me-1"></i>Заключение преподавателя</h6>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="TeacherScore" class="form-label fw-semibold">Выставленный балл</label>
                                <div class="input-group">
                                    <input asp-for="TeacherScore" class="form-control" type="number" min="0" max="@Model.MaxScore" />
                                    <span class="input-group-text">/ @Model.MaxScore</span>
                                </div>
                                <span asp-validation-for="TeacherScore" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label asp-for="TeacherFeedback" class="form-label fw-semibold">Рецензия и замечания к ответу</label>
                            <textarea asp-for="TeacherFeedback" class="form-control" rows="3" placeholder="Укажите рекомендации, правильные аспекты или ошибки студента..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="ReviewAnswers" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Назад к списку
                        </a>
                        <button type="submit" class="btn btn-success px-4 py-2 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i>Утвердить оценку
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
