@model EduCabinet.Web.ViewModels.CreateLectureViewModel
@{
    ViewData["Title"] = "Добавление лекции";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-file-earmark-plus me-2"></i>Добавление новой лекции</h4>
                <small>Тема: @Model.TopicTitle</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateLecture" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TopicId" />
                    <input type="hidden" asp-for="DisciplineId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="Например: Лекция 1. Жизненный цикл внедрения" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Краткое описание темы лекции..."></textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="OrderIndex" class="form-label fw-semibold"></label>
                            <input asp-for="OrderIndex" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PassingScorePercent" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="PassingScorePercent" class="form-control" type="number" min="1" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaterialFile" class="form-label fw-semibold"></label>
                        <input asp-for="MaterialFile" class="form-control" type="file" accept=".pdf,.docx,.doc,.txt,.zip" />
                        <div class="form-text">Поддерживаются форматы PDF, DOCX, DOC, TXT, ZIP.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContentHtml" class="form-label fw-semibold"></label>
                        <textarea asp-for="ContentHtml" class="form-control" rows="6" placeholder="Вставьте текст лекции в формате HTML (заголовки <h4>, списки <ul>, параграфы <p>)..."></textarea>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RequiresTestToUnlockNext" class="form-check-input" type="checkbox" checked />
                        <label asp-for="RequiresTestToUnlockNext" class="form-check-label fw-semibold"></label>
                        <div class="form-text">Если включено, студент не сможет открыть следующую лекцию без успешной сдачи теста.</div>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RequiresQuestionsCheck" class="form-check-input" type="checkbox" checked />
                        <label asp-for="RequiresQuestionsCheck" class="form-check-label fw-semibold"></label>
                        <div class="form-text">Требовать ответы на контрольные вопросы для зачёта лекции.</div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Topics" asp-route-disciplineId="@Model.DisciplineId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Отмена
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2 me-1"></i>Сохранить лекцию
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
