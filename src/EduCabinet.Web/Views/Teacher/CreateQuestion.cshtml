@model EduCabinet.Web.Models.Entities.ControlQuestion
@{
    ViewData["Title"] = "Добавление контрольного вопроса";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-patch-question me-2"></i>Новый контрольный вопрос</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateQuestion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LectureId" />

                    <div class="mb-3">
                        <label asp-for="QuestionText" class="form-label fw-semibold">Текст вопроса</label>
                        <textarea asp-for="QuestionText" class="form-control" rows="3" placeholder="Сформулируйте контрольный вопрос..." required></textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="QuestionType" class="form-label fw-semibold">Тип вопроса</label>
                            <select asp-for="QuestionType" class="form-select">
                                <option value="ShortAnswer">Краткий текстовый ответ (автопроверка)</option>
                                <option value="DetailedAnswer">Развёрнутый ответ (проверка преподавателем)</option>
                                <option value="SingleChoice">Одиночный выбор</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="MaxScore" class="form-label fw-semibold">Макс. балл</label>
                            <input asp-for="MaxScore" class="form-control" type="number" min="1" max="100" value="5" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Порядок</label>
                            <input asp-for="OrderIndex" class="form-control" type="number" min="1" value="1" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CorrectAnswer" class="form-label fw-semibold">Правильный ответ (для автопроверки)</label>
                        <input asp-for="CorrectAnswer" class="form-control" placeholder="Оставьте пустым, если вопрос проверяется вручную" />
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a asp-action="Questions" asp-route-lectureId="@Model.LectureId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Отмена
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2 me-1"></i>Сохранить вопрос
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
