@model List<EduCabinet.Web.Models.Entities.StudentAnswer>
@{
    ViewData["Title"] = "Проверка ответов студентов";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>Проверка развёрнутых ответов</h2>
        <p class="text-muted mb-0">Ответы студентов на контрольные вопросы, требующие ручной оценки преподавателем.</p>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="alert alert-success text-center m-4 py-4">
                <i class="bi bi-check2-all display-4 d-block mb-2 text-success"></i>
                <h5>Все ответы проверены!</h5>
                <p class="text-muted mb-0">Новых ответов, требующих проверки преподавателем, в данный момент нет.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Студент</th>
                            <th>Дисциплина / Лекция</th>
                            <th style="width: 35%;">Вопрос</th>
                            <th>Дата отправки</th>
                            <th class="text-end pe-3">Действие</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@a.Student.FullName</div>
                                    <small class="text-muted">@a.Student.Email</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@a.Question.Lecture.Topic.Discipline.Title</div>
                                    <small class="text-muted">@a.Question.Lecture.Title</small>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 350px;">
                                        @a.Question.QuestionText
                                    </div>
                                </td>
                                <td>
                                    @a.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="GradeAnswer" asp-route-id="@a.Id" class="btn btn-primary btn-sm px-3">
                                        <i class="bi bi-check2-circle me-1"></i>Оценить
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
