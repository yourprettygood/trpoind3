@model EduCabinet.Web.ViewModels.CreateTopicTestViewModel
@{
    ViewData["Title"] = "Добавить тестирование в тему";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Disciplines">Дисциплины</a></li>
        <li class="breadcrumb-item"><a asp-action="Topics" asp-route-disciplineId="@Model.DisciplineId">@Model.DisciplineTitle</a></li>
        <li class="breadcrumb-item active">Добавить тестирование</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                <div class="bg-primary-subtle text-primary p-2 rounded-3 me-3">
                    <i class="bi bi-ui-checks fs-4"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Новое тестирование в тему</h4>
                    <small class="text-muted">Тема: <strong>@Model.TopicTitle</strong></small>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="CreateTopicTest" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TopicId" />
                    <input type="hidden" asp-for="DisciplineId" />
                    <input type="hidden" asp-for="TopicTitle" />
                    <input type="hidden" asp-for="DisciplineTitle" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Название тестирования <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Например: Итоговое тестирование по разделу 1" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Описание или инструкции для студентов</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Кратко опишите, какие разделы затрагивает тест и правила его прохождения..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="PassingScorePercent" class="form-label fw-semibold">Проходной балл (%)</label>
                            <div class="input-group">
                                <input asp-for="PassingScorePercent" type="number" min="1" max="100" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="PassingScorePercent" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MaxAttempts" class="form-label fw-semibold">Количество попыток</label>
                            <input asp-for="MaxAttempts" type="number" min="1" max="50" class="form-control" />
                            <span asp-validation-for="MaxAttempts" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TimeLimitMinutes" class="form-label fw-semibold">Лимит времени</label>
                            <div class="input-group">
                                <input asp-for="TimeLimitMinutes" type="number" min="1" max="300" class="form-control" placeholder="Без лимита" />
                                <span class="input-group-text">мин</span>
                            </div>
                            <span asp-validation-for="TimeLimitMinutes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Порядковый номер в теме</label>
                            <input asp-for="OrderIndex" type="number" min="1" class="form-control" />
                            <span asp-validation-for="OrderIndex" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Deadline" class="form-label fw-semibold">Крайний срок сдачи (дедлайн)</label>
                            <input asp-for="Deadline" type="datetime-local" class="form-control" />
                            <small class="text-muted">Необязательно. Если указан, студенты должны сдать тест до этой даты.</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Topics" asp-route-disciplineId="@Model.DisciplineId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Отмена
                        </a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i>Создать и перейти к добавлению вопросов
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
