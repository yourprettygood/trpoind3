@model EduCabinet.Web.Models.Entities.Lecture
@{
    ViewData["Title"] = "Вопросы и тесты: " + Model.Title;
    var totalTestQuestions = Model.Tests.Sum(t => t.Questions.Count);
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Disciplines">Дисциплины</a></li>
        <li class="breadcrumb-item"><a asp-action="Topics" asp-route-disciplineId="@Model.Topic.DisciplineId">@Model.Topic.Discipline.Title</a></li>
        <li class="breadcrumb-item active">@Model.Title (Вопросы и тесты)</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-patch-question-fill text-primary me-2"></i>Вопросы и тесты
        </h3>
        <p class="text-muted mb-0">Материал: <strong>@Model.Title</strong> (Тема: @Model.Topic.Title)</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#createTestModal">
            <i class="bi bi-plus-circle me-1"></i>+ Создать новый тест
        </button>
        <a asp-action="CreateQuestion" asp-route-lectureId="@Model.Id" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-pencil-square me-1"></i>+ Добавить письменный вопрос
        </a>
    </div>
</div>

<!-- ================= 1. БЛОК ОНЛАЙН-ТЕСТОВ ================= -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0 text-dark">
        <i class="bi bi-ui-checks text-success me-2"></i>Онлайн-тесты (@Model.Tests.Count @(Model.Tests.Count == 1 ? "тест" : (Model.Tests.Count < 5 ? "теста" : "тестов")), всего вопросов: @totalTestQuestions)
    </h4>
    <span class="text-muted small">Вы можете создать несколько разных тестов внутри одной темы или лекции</span>
</div>

@if (!Model.Tests.Any())
{
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-5 text-center text-muted">
            <i class="bi bi-ui-checks display-4 text-secondary mb-3 d-block"></i>
            <h5 class="fw-bold text-dark">В этой теме пока нет ни одного теста</h5>
            <p class="small text-muted mb-3">
                Создайте тест с автоматической проверкой (например, «Входной тест», «Промежуточный срез» или «Итоговый контроль»).
            </p>
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createTestModal">
                <i class="bi bi-plus-circle me-1"></i>Создать первый тест
            </button>
        </div>
    </div>
}
else
{
    @foreach (var test in Model.Tests.OrderBy(t => t.Id))
    {
        var testQuestions = test.Questions.OrderBy(q => q.OrderIndex).ToList();
        string modalId = $"testSettingsModal_{test.Id}";

        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-2 py-1">
                        <i class="bi bi-check2-all me-1"></i>Тест
                    </span>
                    <h5 class="mb-0 fw-bold text-dark">@test.Title</h5>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <a asp-action="CreateTestQuestion" asp-route-testId="@test.Id" class="btn btn-sm btn-success">
                        <i class="bi bi-plus-circle me-1"></i>+ Добавить вопрос
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#@modalId" title="Настройки теста">
                        <i class="bi bi-gear me-1"></i>Настройки
                    </button>
                    <form asp-action="DeleteTest" method="post" class="d-inline" onsubmit="return confirm('Вы действительно хотите удалить тест «@test.Title» со всеми его вопросами и попытками?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="testId" value="@test.Id" />
                        <input type="hidden" name="lectureId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Удалить этот тест">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Информационная плашка настроек теста -->
            <div class="bg-light px-3 py-2 border-bottom d-flex flex-wrap gap-4 align-items-center text-muted small">
                <div>
                    <i class="bi bi-question-circle me-1 text-primary"></i>Вопросов: <strong class="text-dark">@testQuestions.Count</strong>
                </div>
                <div>
                    <i class="bi bi-percent me-1 text-success"></i>Проходной балл: <strong class="text-dark">@test.PassingScorePercent%</strong>
                </div>
                <div>
                    <i class="bi bi-arrow-repeat me-1 text-warning"></i>Попыток: <strong class="text-dark">@test.MaxAttempts</strong>
                </div>
                <div>
                    <i class="bi bi-stopwatch me-1 text-danger"></i>Таймер: <strong class="text-dark">@(test.TimeLimitMinutes.HasValue ? $"{test.TimeLimitMinutes} мин." : "Без ограничения")</strong>
                </div>
            </div>

            <div class="card-body p-0">
                @if (!testQuestions.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <p class="small text-muted mb-2">В этом тесте пока нет вопросов.</p>
                        <a asp-action="CreateTestQuestion" asp-route-testId="@test.Id" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-plus-circle me-1"></i>Добавить вопрос к этому тесту
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%;">№</th>
                                    <th style="width: 45%;">Формулировка вопроса</th>
                                    <th style="width: 35%;">Варианты ответов</th>
                                    <th class="text-center" style="width: 8%;">Баллы</th>
                                    <th class="text-end pe-3" style="width: 7%;">Действие</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in testQuestions)
                                {
                                    <tr>
                                        <td>@q.OrderIndex</td>
                                        <td>
                                            <div class="fw-semibold text-dark">@q.QuestionText</div>
                                            <div class="mt-1">
                                                @if (q.QuestionType == EduCabinet.Web.Models.Entities.QuestionType.SingleChoice)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                                                        <i class="bi bi-ui-radios me-1"></i>Один верный ответ
                                                    </span>
                                                }
                                                else if (q.QuestionType == EduCabinet.Web.Models.Entities.QuestionType.MultipleChoice)
                                                {
                                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle small">
                                                        <i class="bi bi-ui-checks me-1"></i>Множественный выбор
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border small">
                                                        Ввод текста
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (q.Options.Any())
                                            {
                                                <ul class="list-unstyled mb-0 small">
                                                    @foreach (var opt in q.Options.OrderBy(o => o.OrderIndex))
                                                    {
                                                        <li class="mb-1 d-flex align-items-center">
                                                            @if (opt.IsCorrect)
                                                            {
                                                                <span class="badge bg-success me-2 px-2 py-1">
                                                                    <i class="bi bi-check-lg me-1"></i>Верно
                                                                </span>
                                                                <strong class="text-success">@opt.OptionText</strong>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-light text-muted border me-2 px-2 py-1">
                                                                    <i class="bi bi-circle me-1"></i>Вариант
                                                                </span>
                                                                <span class="text-secondary">@opt.OptionText</span>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Нет вариантов ответов</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">
                                                @q.Points @(q.Points == 1 ? "балл" : "балла")
                                            </span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <form asp-action="DeleteTestQuestion" method="post" class="d-inline" onsubmit="return confirm('Удалить этот тестовый вопрос?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@q.Id" />
                                                <input type="hidden" name="lectureId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Удалить вопрос">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Модальное окно настроек конкретного теста -->
        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title">
                            <i class="bi bi-sliders me-2"></i>Параметры теста «@test.Title»
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <form asp-action="UpdateTestSettings" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TestId" value="@test.Id" />
                        <input type="hidden" name="LectureId" value="@Model.Id" />

                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Название теста</label>
                                <input type="text" name="Title" class="form-control" value="@test.Title" required />
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Проходной балл (%)</label>
                                    <div class="input-group">
                                        <input type="number" name="PassingScorePercent" class="form-control" value="@test.PassingScorePercent" min="1" max="100" required />
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Количество попыток</label>
                                    <input type="number" name="MaxAttempts" class="form-control" value="@test.MaxAttempts" min="1" max="100" required />
                                </div>
                            </div>

                            <div class="mt-3">
                                <label class="form-label fw-semibold">Лимит времени (минуты)</label>
                                <div class="input-group">
                                    <input type="number" name="TimeLimitMinutes" class="form-control" value="@test.TimeLimitMinutes" min="1" max="300" placeholder="Без ограничения" />
                                    <span class="input-group-text">мин.</span>
                                </div>
                                <div class="form-text small">Оставьте пустым, если тест должен быть без ограничения по времени.</div>
                            </div>
                        </div>

                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i>Сохранить параметры
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<!-- ================= 2. БЛОК ПИСЬМЕННЫХ КОНТРОЛЬНЫХ ВОПРОСОВ ================= -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <i class="bi bi-file-earmark-text text-primary fs-4 me-2"></i>
            <div>
                <h5 class="mb-0 fw-bold">Письменные контрольные вопросы к лекции</h5>
                <small class="text-muted">Вопросы для развёрнутого ответа студента с ручной проверкой преподавателем</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark fs-6 px-3 py-2 border">
                Вопросов: @Model.ControlQuestions.Count
            </span>
            <a asp-action="CreateQuestion" asp-route-lectureId="@Model.Id" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-plus-circle me-1"></i>Добавить вопрос
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        @if (!Model.ControlQuestions.Any())
        {
            <div class="p-4 text-center text-muted">
                <p class="small text-muted mb-2">В этой лекции нет письменных контрольных вопросов.</p>
                <a asp-action="CreateQuestion" asp-route-lectureId="@Model.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i>Добавить письменный вопрос
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 5%;">№</th>
                            <th style="width: 50%;">Текст вопроса</th>
                            <th>Тип вопроса</th>
                            <th class="text-center">Макс. балл</th>
                            <th class="text-end pe-3">Действие</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model.ControlQuestions.OrderBy(q => q.OrderIndex))
                        {
                            <tr>
                                <td>@q.OrderIndex</td>
                                <td class="fw-semibold">@q.QuestionText</td>
                                <td>
                                    <span class="badge bg-light text-dark border">Развёрнутый ответ</span>
                                </td>
                                <td class="text-center">@q.MaxScore</td>
                                <td class="text-end pe-3">
                                    <form asp-action="DeleteControlQuestion" method="post" class="d-inline" onsubmit="return confirm('Удалить этот контрольный вопрос?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@q.Id" />
                                        <input type="hidden" name="lectureId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Удалить вопрос">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ================= МОДАЛЬНОЕ ОКНО СОЗДАНИЯ НОВОГО ТЕСТА ================= -->
<div class="modal fade" id="createTestModal" tabindex="-1" aria-labelledby="createTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="createTestModalLabel">
                    <i class="bi bi-plus-circle me-2"></i>Создать новый тест
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <form asp-action="CreateTest" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="LectureId" value="@Model.Id" />

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Название нового теста <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control" placeholder="Например: Промежуточный тест №2 или Итоговый срез" required autofocus />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Проходной балл (%)</label>
                            <div class="input-group">
                                <input type="number" name="PassingScorePercent" class="form-control" value="70" min="1" max="100" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Количество попыток</label>
                            <input type="number" name="MaxAttempts" class="form-control" value="3" min="1" max="50" required />
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold">Лимит времени (минуты)</label>
                        <div class="input-group">
                            <input type="number" name="TimeLimitMinutes" class="form-control" value="15" min="1" max="300" placeholder="Без ограничения" />
                            <span class="input-group-text">мин.</span>
                        </div>
                        <div class="form-text small">Оставьте пустым, если тест должен быть без ограничения по времени.</div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-success fw-semibold">
                        <i class="bi bi-check-circle me-1"></i>Создать тест
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
