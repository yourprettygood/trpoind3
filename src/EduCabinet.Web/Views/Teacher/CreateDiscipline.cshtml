@model EduCabinet.Web.Models.Entities.Discipline
@{
    ViewData["Title"] = "Создание дисциплины";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-folder-plus me-2"></i>Добавление новой дисциплины</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateDiscipline" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Название дисциплины</label>
                        <input asp-for="Title" class="form-control" placeholder="Например: Внедрение и поддержка компьютерных систем" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Краткое описание курса</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Опишите цели изучения курса, требования и результаты..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="IsPublished" class="form-check-input" type="checkbox" checked />
                        <label asp-for="IsPublished" class="form-check-label">Опубликовать курс (будет виден студентам)</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Disciplines" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Отмена
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2 me-1"></i>Сохранить курс
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
