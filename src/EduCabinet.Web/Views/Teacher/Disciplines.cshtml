@model List<EduCabinet.Web.Models.Entities.Discipline>
@{
    ViewData["Title"] = "Учебные дисциплины";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-folder2-open text-primary me-2"></i>Реестр учебных дисциплин</h2>
        <p class="text-muted mb-0">Создание курсов, редактирование тем и лекций, контроль прав доступа.</p>
    </div>
    <a asp-action="CreateDiscipline" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Новая дисциплина
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40%;">Дисциплина</th>
                        <th>Преподаватель</th>
                        <th class="text-center">Темы</th>
                        <th class="text-center">Лекции</th>
                        <th class="text-end pe-3">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        var lectureCount = d.Topics.SelectMany(t => t.Lectures).Count();
                        <tr>
                            <td>
                                <div class="fw-bold">@d.Title</div>
                                <small class="text-muted">@d.Description</small>
                            </td>
                            <td>@(d.Teacher?.FullName ?? "Иванов С.П.")</td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@d.Topics.Count</span></td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@lectureCount</span></td>
                            <td class="text-end pe-3">
                                <a asp-action="Journal" asp-route-disciplineId="@d.Id" class="btn btn-outline-success btn-sm me-1">
                                    <i class="bi bi-journal-text me-1"></i>Ведомость
                                </a>
                                <a asp-action="Topics" asp-route-disciplineId="@d.Id" class="btn btn-primary btn-sm">
                                    <i class="bi bi-pencil-square me-1"></i>Управление
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
