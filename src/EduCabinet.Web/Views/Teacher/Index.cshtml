@model EduCabinet.Web.ViewModels.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Панель преподавателя";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Панель управления преподавателя</h2>
        <p class="text-muted mb-0">Управление учебными курсами, загрузка материалов, контроль успеваемости и проверка ответов.</p>
    </div>
    <a asp-action="CreateDiscipline" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Добавить дисциплину
    </a>
</div>

<!-- Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3 fs-3">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small">Дисциплин</h6>
                    <h3 class="fw-bold mb-0">@Model.Disciplines.Count</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 me-3 fs-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small">Студентов в базе</h6>
                    <h3 class="fw-bold mb-0">@Model.TotalStudentsCount</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 me-3 fs-3">
                    <i class="bi bi-hourglass-top"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small">Ожидают проверки</h6>
                    <h3 class="fw-bold mb-0">@Model.PendingReviewsCount</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-3 me-3 fs-3">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small">Попыток за 7 дней</h6>
                    <h3 class="fw-bold mb-0">@Model.RecentAttemptsCount</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Disciplines Table -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-collection me-2"></i>Мои дисциплины</h5>
        <a asp-action="Disciplines" class="btn btn-outline-secondary btn-sm">Все курсы</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40%;">Название</th>
                        <th class="text-center">Темы</th>
                        <th class="text-center">Лекции</th>
                        <th class="text-center">Статус</th>
                        <th class="text-end pe-3">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Disciplines)
                    {
                        var lectureCount = d.Topics.SelectMany(t => t.Lectures).Count();
                        <tr>
                            <td>
                                <div class="fw-bold">@d.Title</div>
                                <small class="text-muted">@d.Description</small>
                            </td>
                            <td class="text-center">@d.Topics.Count</td>
                            <td class="text-center">@lectureCount</td>
                            <td class="text-center">
                                <span class="badge @(d.IsPublished ? "bg-success" : "bg-secondary")">
                                    @(d.IsPublished ? "Опубликована" : "Черновик")
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Journal" asp-route-disciplineId="@d.Id" class="btn btn-outline-success btn-sm me-1" title="Ведомость группы">
                                    <i class="bi bi-table me-1"></i>Ведомость
                                </a>
                                <a asp-action="Topics" asp-route-disciplineId="@d.Id" class="btn btn-outline-primary btn-sm" title="Управление структурой">
                                    <i class="bi bi-gear me-1"></i>Структура
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
